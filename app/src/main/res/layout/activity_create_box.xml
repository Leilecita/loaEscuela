<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/background_rose"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/toolbar"
        android:background="@color/colorPrimary">

        <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/line_home"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:id="@+id/home"
                android:src="@drawable/returnn"
                android:layout_marginRight="4dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:id="@+id/title"
                android:text="  Caja del día"
                style="@style/TitleStyle"
                />

        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <TextView
        android:layout_width="match_parent"
        android:textSize="18sp"
        android:textColor="@color/colorPrimaryDarkLetterRose"
        android:id="@+id/te"
        android:text="Cierre diario de caja playa"
        android:gravity="center_vertical"
        android:layout_below="@id/toolbar"
        android:paddingLeft="16dp"
        android:fontFamily="@font/opensansregular"
        android:layout_height="34dp"
        android:background="#F3D9E5"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_weight="1"
        android:layout_height="35dp"
        android:layout_marginTop="16dp"
        android:layout_gravity="center"
        android:id="@+id/change_category"
        android:layout_below="@id/te"
        android:gravity="center"
        android:orientation="horizontal">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_gravity="right"
            android:layout_marginRight="16dp"
            android:gravity="right"
            android:layout_height="wrap_content">

            <FrameLayout
                android:layout_width="200dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@drawable/custom_button_3"
                android:orientation="horizontal"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:layout_width="100dp"
                    android:id="@+id/gen"
                    android:background="@drawable/custom_button_3a"
                    android:layout_height="wrap_content"
                    >

                    <TextView
                        android:layout_width="match_parent"
                        android:textSize="18sp"
                        android:text="escuela"
                        android:id="@+id/text_porcentaje"
                        android:textColor="@color/white"
                        android:layout_gravity="center_vertical"
                        android:gravity="center"
                        android:fontFamily="@font/opensansregular"
                        android:layout_height="match_parent"

                        />

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/comision"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="right"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/text_comision"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:fontFamily="@font/opensansregular"

                        android:gravity="center"
                        android:text="colonia"
                        android:textColor="@color/colorPrimaryLetterRose"
                        android:textSize="18sp"

                        />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>
    </LinearLayout>


    <ScrollView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/change_category"
        android:layout_marginTop="0dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="14dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:orientation="vertical"
            android:paddingTop="2dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:gravity="center_horizontal">

                    <RelativeLayout
                        android:id="@+id/date_picker"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bblanco"
                        android:backgroundTint="@color/coloRose_soft_soft"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/month"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center_horizontal"
                            android:paddingTop="3dp"
                            android:text="MAY"
                            android:textAllCaps="true"
                            android:textColor="@color/colorPrimaryDarkLetterRose"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/day"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:fontFamily="sans-serif"
                            android:gravity="center_horizontal"
                            android:paddingTop="13sp"
                            android:text="12"
                            android:textColor="@color/colorPrimaryDarkLetterRose"
                            android:textSize="17sp"

                            />

                    </RelativeLayout>


                </LinearLayout>


                <TextView
                    android:id="@+id/date"
                    style="@style/Widget.Design.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:layout_weight="1"
                    android:background="@drawable/rec_find"
                    android:gravity="center_vertical"
                    android:inputType="textCapWords"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:text="10/10/2020"
                    android:textColor="@color/colorPrimaryClear"
                    android:textSize="19sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/rec_find"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="4dp" />


                <TextView

                    style="@style/Widget.Design.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="Tarjeta"
                    android:inputType="textCapWords"
                    android:paddingLeft="8dp"
                    android:textColor="@color/word"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Design.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:layout_marginRight="8dp"
                android:layout_weight="1"
                android:paddingLeft="8dp"
                android:text="Venta tarjeta"
                android:textColor="@color/word"
                android:textSize="18sp" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/rec_find"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical" />

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="Venta contado"
                    android:inputType="textCapWords"
                    android:textColor="@color/word"

                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Design.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:layout_marginRight="8dp"
                android:layout_weight="1"
                android:paddingLeft="8dp"
                android:text="Venta contado"
                android:textColor="@color/word"
                android:textSize="18sp" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/line_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginRight="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Design.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Total efectivo"
                    android:textColor="@color/colorPrimaryDarkLetterRose"
                    android:textSize="@dimen/general_text" />


                <TextView
                    android:id="@+id/counted_sale"
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:layout_weight="1"
                    android:background="@drawable/rec_complette"

                    android:gravity="center_vertical|right"
                    android:paddingRight="8dp"
                    android:text=""
                    android:textColor="@color/colorPrimaryDarkLetterRose"
                    android:textSize="@dimen/general_text" />


            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginRight="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Design.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Resto caja ant"
                    android:textColor="@color/colorPrimaryDarkLetterRose"
                    android:textSize="@dimen/general_text" />


                <TextView
                    android:id="@+id/res_box_day_before"
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:layout_weight="1"
                    android:background="@drawable/rec_complette"

                    android:gravity="center_vertical|right"
                    android:paddingRight="8dp"
                    android:text=""
                    android:textColor="@color/colorPrimaryDarkLetterRose"
                    android:textSize="@dimen/general_text" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginRight="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Design.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Total digital"
                    android:textColor="@color/colorPrimaryDarkLetterRose"
                    android:textSize="@dimen/general_text" />

                <TextView
                    android:id="@+id/credit_card"
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:layout_weight="1"
                    android:background="@drawable/rec_complette"
                    android:gravity="center_vertical|right"

                    android:paddingRight="8dp"
                    android:text=""
                    android:textColor="@color/colorPrimaryDarkLetterRose"
                    android:textSize="@dimen/general_text" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginRight="8dp"
                android:orientation="horizontal">
                <TextView
                    style="@style/Widget.Design.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/opensansregular"
                    android:gravity="center_vertical"
                    android:text="Caja total"
                    android:textColor="@color/colorPrimaryDarkLetterRose"
                    android:textSize="@dimen/general_text" />

                <EditText
                    android:id="@+id/total_amount"
                    style="@style/Widget.Design.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:layout_weight="1"
                    android:background="@drawable/rec_find"
                    android:gravity="center_vertical|right"
                    android:hint=""
                    android:inputType="textCapWords"
                    android:paddingRight="8dp"
                    android:textColor="@color/colorPrimaryDarkLetterRose"
                    android:textSize="@dimen/general_text" />


            </LinearLayout>


            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginRight="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Tot extr/gastos"
                    android:textColor="@color/colorPrimaryDarkLetterRose"
                    android:textSize="@dimen/general_text" />


                <TextView
                    android:id="@+id/tot_extract"
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:layout_weight="1"
                    android:background="@drawable/rec_complette"
                    android:gravity="center_vertical|right"
                    android:paddingRight="8dp"
                    android:text=""
                    android:textColor="@color/colorPrimaryDarkLetter"
                    android:textSize="@dimen/general_text" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginRight="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Resto de caja"
                    android:textColor="@color/colorPrimaryDarkLetterRose"
                    android:textSize="@dimen/general_text" />

                <EditText
                    android:id="@+id/rest_box"
                    style="@style/Widget.Design.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:layout_weight="1"
                    android:background="@drawable/rec_find"
                    android:gravity="center_vertical|right"
                    android:hint=""
                    android:inputType="textCapWords"
                    android:paddingRight="8dp"
                    android:textColor="@color/colorPrimaryDarkLetterRose"
                    android:textSize="@dimen/general_text" />


            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="2dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/deposit"
                        style="@style/Widget.Design.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="33dp"
                        android:layout_marginRight="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/rec_text_edit"
                        android:hint="Deposito"
                        android:paddingLeft="8dp"
                        android:textColor="@color/colorPrimaryDarkLetterRose"
                        android:textSize="16sp"
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/detail"
                        style="@style/Widget.Design.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="33dp"
                        android:layout_weight="1"
                        android:background="@drawable/rec_find"
                        android:focusable="false"
                        android:gravity="center_vertical"
                        android:hint="Detalle"
                        android:inputType="textCapWords"
                        android:paddingLeft="8dp"
                        android:textColor="@color/colorPrimaryDarkLetterRose"
                        android:textColorHint="@color/colorPrimaryClear"
                        android:textSize="@dimen/general_text" />
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"

                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:id="@+id/load_ext"

                    android:background="@drawable/rec_rounded_8"
                    android:backgroundTint="#F3D9E5"

                    android:paddingLeft="12dp"
                    android:paddingTop="6dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/add3"
                        android:layout_gravity="center_vertical"
                        app:tint="@color/colorPrimaryDarkLetterRose" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:fontFamily="@font/opensansregular"
                        android:paddingLeft="8dp"
                        android:text="Cargar extraccion"
                        android:textColor="@color/colorPrimaryDarkLetterRose"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_gravity="right"
                    android:gravity="right"
                    android:layout_height="wrap_content">


                    <LinearLayout
                        android:id="@+id/fab_save"
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:layout_gravity="right"
                        android:layout_margin="30dp"

                        android:background="@drawable/bblanco"
                        android:backgroundTint="@color/colorbutton"
                        android:gravity="right">


                        <ImageView
                            android:id="@+id/image_button"
                            android:layout_width="65dp"
                            android:layout_height="match_parent"
                            android:padding="18dp"
                            android:src="@drawable/save" />

                    </LinearLayout>
                </LinearLayout>
                </LinearLayout>


            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/line_photos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone"

                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/select_photo"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:layout_marginTop="15dp"
                            android:layout_marginRight="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/rec_find"
                            android:backgroundTint="@color/colorDialogButton">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="4dp"
                                android:layout_weight="1"
                                android:padding="4dp"
                                android:src="@drawable/camera"
                                android:textColor="#ffff" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginLeft="18sp"
                                android:text="detalle ventas"
                                android:textColor="@color/word_clear2"

                                />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/select_photo_posnet"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:layout_marginLeft="4dp"
                            android:layout_marginTop="15dp"
                            android:layout_weight="1"
                            android:background="@drawable/rec_find"
                            android:backgroundTint="@color/colorDialogButton">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="35dp"
                                android:layout_weight="1"
                                android:background="@drawable/rec_find"
                                android:backgroundTint="@color/colorDialogButton"
                                android:padding="4dp"

                                android:src="@drawable/camera"
                                android:textColor="#ffff"

                                />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginLeft="18sp"
                                android:text="cierre lote"
                                android:textColor="@color/word_clear2"

                                />

                        </LinearLayout>
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imageview"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="10dp"
                            android:layout_weight="1"
                            android:padding="4dp"
                            android:src="@drawable/camera"
                            android:textColor="#ffff"

                            />

                        <ImageView
                            android:id="@+id/imageview_posnet"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="10dp"
                            android:layout_weight="1"
                            android:padding="4dp"
                            android:src="@drawable/camera"
                            android:textColor="#ffff"

                            />

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right"
                        android:gravity="right"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/finish_save"
                            android:layout_width="wrap_content"
                            android:layout_height="35dp"
                            android:background="@drawable/rec_find"
                            android:backgroundTint="@color/colorDialogButton">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:fontFamily="@font/opensansregular"
                                android:gravity="center"
                                android:paddingLeft="12dp"
                                android:paddingRight="12dp"
                                android:text="Finalizar carga"
                                android:textColor="@color/white"

                                />


                        </LinearLayout>


                    </LinearLayout>


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginRight="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/opensansregular"
                        android:gravity="center_vertical"
                        android:text="Caja guardada, a continuación cargue foto de la planilla ventas y el cierre de lote."
                        android:textColor="@color/colorPrimaryDarkLetter"
                        android:textSize="@dimen/general_text" />

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>